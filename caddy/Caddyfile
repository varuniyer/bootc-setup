{
	email {$ACME_EMAIL}
	admin off
	persist_config off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(static_files) {
	file_server {
		precompressed br gzip
	}
}

{$DOMAIN} {
	import security_headers

	root * /usr/share/website

	@assets path *.webp *.css *.js
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"

	import static_files

	handle_errors 404 {
		rewrite * /404.html
		import static_files
	}
}

{$REDIR_LIST} {
	redir https://{$DOMAIN}{uri} permanent
}

mta-sts.{$DOMAIN} {
	import security_headers
	root * /run/caddy/mta-sts
	file_server
}
