[Unit]
Description=Tailscale node agent
# Before DHCP finishes, resolved has no upstream DNS and tailscaled's first dials fail.
Wants=network-online.target
After=network-online.target systemd-resolved.service

[Service]
Type=notify
DynamicUser=yes
ExecStart=/usr/bin/tailscaled --tun=userspace-networking --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=41641
Restart=on-failure
RuntimeDirectory=tailscale
RuntimeDirectoryMode=0755
StateDirectory=tailscale
StateDirectoryMode=0700
CacheDirectory=tailscale
CacheDirectoryMode=0750

RestrictAddressFamilies=AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
