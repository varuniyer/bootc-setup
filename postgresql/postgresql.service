[Unit]
Description=PostgreSQL database server
Requires=boot-postgresql.service
After=network.target boot-postgresql.service

[Service]
Type=notify
ExecStart=/usr/bin/postgres -c config_file=/usr/share/boot-postgresql/postgresql.conf
KillSignal=SIGINT
TimeoutStartSec=infinity
TimeoutStopSec=120

IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
