[Unit]
Description=PostgreSQL bootstrap and per-boot config copy
Requires=boot-root.service
After=boot-root.service

[Service]
Type=oneshot
Environment=PGHOST=/run/postgresql
ExecStart=/opt/scripts/boot-postgresql.sh
ExecStartPost=+/usr/bin/rm -f /run/boot-postgresql/hash
RemainAfterExit=yes

CapabilityBoundingSet=
