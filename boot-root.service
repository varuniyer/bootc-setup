[Unit]
Description=Root-side boot configuration from instance metadata
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=creds
ExecStart=/opt/scripts/boot-root.sh
RemainAfterExit=yes
RuntimeDirectory=boot-postgresql
RuntimeDirectoryMode=0750

CapabilityBoundingSet=CAP_DAC_READ_SEARCH
IPAddressAllow=169.254.169.254
ReadWritePaths=/run/caddy /etc/webdav /etc/pki/containers
